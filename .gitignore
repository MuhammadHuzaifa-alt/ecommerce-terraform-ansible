# Terraform working directory
.terraform/

# Terraform state files (may contain sensitive values)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files may contain credentials
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Saved Terraform plans
*.tfplan
tfplan
plan.out

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and local overrides
.terraformrc
terraform.rc

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
